# Nguồn để nghiên cứu, không phải mã nguồn — nặng và không cần trong lịch sử.
*.xapk
Recording*.mp4

# Kết quả build, dựng lại được bằng tools/. dist/ là gói nộp CrazyGames (nội
# dung của nó chính là thứ kéo lên portal); build/ là bản một file và thư mục
# Firebase Hosting.
dist/
build/

# Bản giải mã thô từ APK (15MB); data/*.json đã là bản đóng gói dùng được.
data/raw/

# Ảnh gốc gửi sang để cắt ra assets/ — nặng, và bản đã cắt mới là bản dùng.
Manythings/

# Cache của Firebase CLI, sinh lại mỗi lần deploy.
.firebase/
